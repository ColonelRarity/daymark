{
  "expo": {
    "name": "Daymark",
    "slug": "daymark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "daymark",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.daymark.ios",
      "usesAppleSignIn": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Камера потрібна, щоб сфотографувати страву. Знімок лишається на цьому пристрої.",
        "NSPhotoLibraryUsageDescription": "Галерея потрібна, щоб додати фото страви. Знімок лишається на цьому пристрої."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F5F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.daymark.android"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4F5F0"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-image-picker",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
